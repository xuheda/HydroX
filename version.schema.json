{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oceanx.local/hydrox/version.schema.json",
  "title": "HydroX Version Manifest",
  "description": "HydroX component identity, compatibility contracts, build targets, and dependency revisions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "component",
    "compatibility",
    "build_requirements",
    "build_targets",
    "dependencies",
    "dependency_locks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "HydroX"
        },
        "version": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hil_session",
        "hitl_command",
        "xlog",
        "vehicle_bundle",
        "geodesy_contract"
      ],
      "properties": {
        "hil_session": {
          "$ref": "#/$defs/positiveInteger"
        },
        "hitl_command": {
          "$ref": "#/$defs/positiveInteger"
        },
        "xlog": {
          "$ref": "#/$defs/formatVersion"
        },
        "vehicle_bundle": {
          "$ref": "#/$defs/formatVersion"
        },
        "geodesy_contract": {
          "$ref": "#/$defs/positiveInteger"
        }
      }
    },
    "build_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cmake_minimum",
        "cpp_standard"
      ],
      "properties": {
        "cmake_minimum": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "cpp_standard": {
          "enum": [
            17,
            20,
            23
          ]
        }
      }
    },
    "build_targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "host",
          "pixhawk6c_hitl"
        ]
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eigen",
        "micro_cdr",
        "micro_xrce_dds_client",
        "mavlink_c",
        "geographiclib_c",
        "openssl"
      ],
      "properties": {
        "eigen": {
          "$ref": "#/$defs/versionedDependency"
        },
        "micro_cdr": {
          "$ref": "#/$defs/revisionedDependency"
        },
        "micro_xrce_dds_client": {
          "$ref": "#/$defs/revisionedDependency"
        },
        "mavlink_c": {
          "$ref": "#/$defs/revisionOnlyDependency"
        },
        "geographiclib_c": {
          "$ref": "#/$defs/versionedDependency"
        },
        "openssl": {
          "$ref": "#/$defs/versionedDependency"
        }
      }
    },
    "dependency_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nuttx",
        "arm_gnu_toolchain"
      ],
      "properties": {
        "nuttx": {
          "$ref": "#/$defs/lockPath"
        },
        "arm_gnu_toolchain": {
          "$ref": "#/$defs/lockPath"
        }
      }
    }
  },
  "$defs": {
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "formatVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "resolution": {
      "type": "string",
      "enum": [
        "vendored",
        "fetch_content",
        "system"
      ]
    },
    "versionedDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "resolution"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "resolution": {
          "$ref": "#/$defs/resolution"
        }
      }
    },
    "revisionedDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "revision",
        "resolution"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "resolution": {
          "$ref": "#/$defs/resolution"
        }
      }
    },
    "revisionOnlyDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "resolution"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "resolution": {
          "$ref": "#/$defs/resolution"
        }
      }
    },
    "lockPath": {
      "type": "string",
      "pattern": "^third_party/[A-Za-z0-9_.-]+\\.lock\\.json$"
    }
  }
}
